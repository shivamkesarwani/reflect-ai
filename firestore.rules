rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all documents not explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    // User reflections and profile data strictly isolated to the authenticated owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /entries/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /{subPath=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
